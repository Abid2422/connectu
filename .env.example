# Postgres (used directly by docker-compose)
POSTGRES_USER=connectu
POSTGRES_PASSWORD=connectu
POSTGRES_DB=connectu
POSTGRES_PORT=5432

# Backend
NODE_ENV=development
PORT=4000

# Prisma connection string (must match POSTGRES_* above when using docker-compose)
DATABASE_URL="postgresql://connectu:connectu@localhost:5432/connectu?schema=public"

# Redis (OTP resend rate limiting)
REDIS_URL="redis://localhost:6379"

# Resend (https://resend.com) — used to send OTP emails
RESEND_API_KEY=
EMAIL_FROM="ConnectU <onboarding@resend.dev>"

# Session / JWT secret — used to sign the session cookie issued after OTP verification
SESSION_SECRET=change-me-in-production

# Object storage for profile photos (Cloudflare R2 in production).
# Local dev talks to the bundled MinIO service instead — set R2_ENDPOINT to
# it and R2_ACCOUNT_ID isn't needed. In production, drop R2_ENDPOINT and set
# R2_ACCOUNT_ID so the SDK derives the real R2 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=connectu
R2_SECRET_ACCESS_KEY=connectu123
R2_BUCKET_NAME=connectu-photos
R2_PUBLIC_URL="http://localhost:9000/connectu-photos"
R2_ENDPOINT="http://localhost:9000"

# Origin allowed to make credentialed (cookie) requests to the backend
FRONTEND_ORIGIN="http://localhost:5173"

# Frontend
VITE_API_BASE_URL="http://localhost:4000"
